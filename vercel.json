{
  "images": {
    "sizes": [
      160,
      320,
      640,
      960,
      1280
    ],
    "qualities": [
      75
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "scftuxrtflfowohiewsc.supabase.co",
        "pathname": "^/storage/v1/object/public/.*$"
      }
    ]
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/og?tipo=sitemap"
    },
    {
      "source": "/producto/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|facebookexternalhit|WhatsApp|Slack|Pinterest|Embedly|Google-|crawler|spider).*"
        }
      ],
      "destination": "/api/og?tipo=producto&id=:id"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|facebookexternalhit|WhatsApp|Slack|Pinterest|Embedly|Google-|crawler|spider).*"
        }
      ],
      "destination": "/api/og?tipo=post&slug=:slug"
    },
    {
      "source": "/inscripcion/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|facebookexternalhit|WhatsApp|Slack|Pinterest|Embedly|Google-|crawler|spider).*"
        }
      ],
      "destination": "/api/og?tipo=evento&id=:id"
    },
    {
      "source": "/:p(tienda|torneos|ranking|eventos|blog|galeria|mapa|contacto)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|facebookexternalhit|WhatsApp|Slack|Pinterest|Embedly|Google-|crawler|spider).*"
        }
      ],
      "destination": "/api/og?tipo=pagina&p=:p"
    },
    {
      "source": "/((?!api/|assets/|_vercel/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-3kVnXB3hPh0vLoZCTE6DrSnlP6ObvI00YImEOh427dk=' 'sha256-MS6/3FCg4WjP9gwgaBGwLpRCY6fZBgwmhVCdrPrNf3E=' 'sha256-tQjf8gvb2ROOMapIxFvFAYBeUJ0v1HCbOcSmDNXGtDo=' 'sha256-VA8O2hAdooB288EpSTrGLl7z3QikbWU9wwoebO/QaYk=' 'sha256-+5XkZFazzJo8n0iOP4ti/cLCMUudTf//Mzkb7xNPXIc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://scftuxrtflfowohiewsc.supabase.co wss://scftuxrtflfowohiewsc.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/csp"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(products|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
