# Supabase project (events, clubs, announcements, orders persistence)
# Get these from https://supabase.com/dashboard → Project Settings → API
# If left empty, the app falls back to localStorage automatically.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Admin panel password (overrides the default "adminvolea")
VITE_ADMIN_PASSWORD=
